__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
build/
dist/
*.egg-info/
.venv/
venv/

# The pruned trainer IS committed (self-contained tests/builds). Only the large
# platform-specific `uv` binary is fetched at build time.
packaging/vendor/uv
packaging/vendor/uv.exe

# Runtime artifacts if the self-test is run against the vendored trainer
packaging/vendor/trainer/tb_logger/
packaging/vendor/trainer/experiments/
packaging/vendor/trainer/options/train/ABLATION/

# polycheck run reports are point-in-time artifacts; the baseline travels
# with the repo so `--diff` runs judge only new findings everywhere.
polycheck-reports/*
!polycheck-reports/polycheck-baseline.json
